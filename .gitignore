# Repository root = wp-content/.
# Only our own code is tracked: the itw-corp theme and the mu-plugins.
# WordPress core, uploads, third-party plugins and backups stay out of git.

/*
!/.gitignore
!/LICENSE
!/README.md

!/themes/
/themes/*
!/themes/itw-corp/

!/mu-plugins/

# OS and editor files anywhere
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log

# Secrets
.env
.env.*
!.env.example
